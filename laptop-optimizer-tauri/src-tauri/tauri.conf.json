{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LaptopOptimizer",
  "version": "1.0.0",
  "identifier": "com.laptopoptimizer.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "// SYS.CORE-TUNER // [CYBERCORE TECHWEAR WORKSTATION]",
        "width": 940,
        "height": 680,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
