{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-system-info",
    "allow-get-live-telemetry",
    "allow-get-elevation",
    "allow-is-applied",
    "allow-apply-tweak",
    "allow-restore-tweak",
    "allow-restore-all",
    "allow-get-startup-apps",
    "allow-toggle-startup-app"
  ]
}
